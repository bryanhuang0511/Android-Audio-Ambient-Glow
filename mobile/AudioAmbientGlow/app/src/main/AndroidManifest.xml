<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 懸浮視窗與頂層覆蓋權限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- 前台服務與通知權限 (Android 14+ 內部音訊串流截取相容) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AudioAmbientGlowApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.AudioAmbientGlow">

        <!-- 主控制儀表板 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- AMOLED AOD 息屏音樂氣氛燈活動 (支援桌面小工具與捷徑一鍵喚起，相容 Material 主題) -->
        <activity
            android:name=".service.AodGlowActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="false"
            android:excludeFromRecents="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.AudioAmbientGlow.TranslucentAod"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 桌面小工具廣播接收器 (Desktop App Widget) -->
        <receiver
            android:name=".receiver.AodGlowWidgetProvider"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aod_widget_info" />
        </receiver>

        <!-- 滿版流光懸浮邊框服務 (支援內部音訊串流截取與背景流光) -->
        <service
            android:name=".service.GlowOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaPlayback|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Full-screen ambient audio border lighting overlay" />
        </service>

        <!-- 系統媒體播放感知服務 (Hook into YouTube Music / Spotify / 系統音樂卡片) -->
        <service
            android:name=".service.GlowNotificationListenerService"
            android:label="手機音效氣氛燈媒體感知"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 頂部下拉快捷開關 (Quick Settings Tile) -->
        <service
            android:name=".service.GlowTileService"
            android:icon="@drawable/ic_tile_glow"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
